<Window x:Class="TexImgSheet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TexImgSheet" mc:Ignorable="d"
        Title="TexImage Sheet Creator" Height="800" Width="720" Icon="TexImgSheet.ico">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="20px" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="8" HorizontalAlignment="Center">

            <Button x:Name="PickXmlButton" Margin="16" Click="PickXmlButton_Click">
                <TextBlock>Pick XML File...</TextBlock>
            </Button>

            <TextBlock x:Name="CellWidthTextBlock" Text="Cell Width: 64px" Margin="8" HorizontalAlignment="Center"></TextBlock>
            <TextBlock x:Name="CellHeightTextBlock" Text="Cell Height: 64px" Margin="0" HorizontalAlignment="Center"></TextBlock>
            <TextBlock x:Name="DimTextBlock" Text="1 row(s) x 1 col(s)" Margin="8" HorizontalAlignment="Center"></TextBlock>

            <Button x:Name="ExportPngButton" Margin="16,16,16,4" Click="ExportPngButton_Click">
                <TextBlock>Export PNG Now...</TextBlock>
            </Button>

            <ProgressBar x:Name="ExportProgress" Margin="16 0" Height="16" Minimum="0" Maximum="100" Value="0" />
        </StackPanel>

        <Border Grid.Column="1" Grid.Row="0" BorderBrush="Black" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Grid.Row="0" Text="Row" HorizontalAlignment="Center" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Grid.Row="0" Text="Col" HorizontalAlignment="Center" FontWeight="Bold" />
                <TextBlock Grid.Column="2" Grid.Row="0" Text="File Name" HorizontalAlignment="LEft" FontWeight="Bold" />
            </Grid>
        </Border>

        <ListView x:Name="FileItemListView" Grid.Column="1" Grid.Row="1" AllowDrop="True" Drop="FileItemListView_Drop">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="4*" />
                        </Grid.ColumnDefinitions>

                         <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding Row, Mode=OneWay}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Col, Mode=OneWay}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Grid.Row="0" Text="{Binding FileName, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
